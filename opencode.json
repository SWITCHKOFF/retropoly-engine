{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:~/.config/opencode/secrets/context7_api_key}"
        }
      },
      "testsprite": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "export PATH=\"$HOME/.local/opt/node22/bin:$PATH\"; exec npx -y @testsprite/testsprite-mcp@latest"
        ],
        "environment": {
          "API_KEY": "{file:~/.config/opencode/secrets/testsprite_api_key}"
        },
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
