@PACKAGE_INIT@

# RetroPolyEngine SDK — CMake package (S33–34, ADR-011).
#
# Использование:
#   find_package(RetroPolyEngine CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE RetroPolyEngine::retro_engine)
#
# Публичные заголовки: <retro_engine/retro_engine.h>.
include(CMakeFindDependencyMacro)

if("@RPE_PLATFORM_NAME@" STREQUAL "pc")
    find_dependency(OpenGL REQUIRED)
    if(NOT TARGET SDL3::SDL3)
        if(EXISTS "${PACKAGE_PREFIX_DIR}/@RPE_SDL3_INSTALL_CMAKEDIR@/SDL3Config.cmake")
            find_dependency(SDL3 CONFIG REQUIRED
                PATHS "${PACKAGE_PREFIX_DIR}/@RPE_SDL3_INSTALL_CMAKEDIR@"
                NO_DEFAULT_PATH)
        else()
            find_dependency(SDL3 CONFIG REQUIRED)
        endif()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RetroPolyEngineTargets.cmake")

check_required_components(RetroPolyEngine)
