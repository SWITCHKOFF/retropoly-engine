# ci/lsan_suppressions.supp — исключения LeakSanitizer (PC).
#
# Спринт 5–6 подключил создание системных GL-контекстов (SDL3 → Mesa/libgallium):
# известная долгоживущая память ВНУТРИ системного GL-драйвера (контекстные
# bitmask-реестры, не освобождаются при glXDestroyContext — поведение Mesa).
# Это НЕ утечки движка: код движка (HAL/ECS/memory) остаётся под полной
# проверкой; шаблоны сверяются с системами и в CI, где драйверы отличаются —
# несоответствие шаблонов является no-op (безопасно для Windows/macOS).
#
leak:libgallium
leak:libGLX
